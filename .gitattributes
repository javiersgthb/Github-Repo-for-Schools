# Normalize line endings for text files (stored LF, checked out native)
* text=auto

# Binary assets: store as-is, never line-ending convert
*.psd   binary
*.pptx  binary
*.ppt   binary
*.docx  binary
*.doc   binary
*.xlsx  binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.mov   binary
*.mp4   binary
